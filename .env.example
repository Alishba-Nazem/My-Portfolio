# Copy this file to `.env` and paste your real key in.
# `.env` is gitignored, so your key never gets committed.
#
# Free key (no card needed): https://console.groq.com/keys
# On Vercel, add the same variable under Settings -> Environment Variables.
GROQ_API_KEY=

# Powers the contact form (Section 5 "Send Message"). Free, no card needed:
# 1. Go to https://web3forms.com, enter alishbanazem@gmail.com, get your access key by email.
# 2. Paste it below as VITE_WEB3FORMS_KEY.
# 3. On Vercel, add the same variable under Settings -> Environment Variables
#    (must start with VITE_ so the frontend can read it).
# Without this key, the form still works — it just falls back to opening
# the visitor's own email app instead of sending silently.
VITE_WEB3FORMS_KEY=
